# Database (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/mirrorme

# Application
PORT=3000
NODE_ENV=development

# Public URL (set to your Railway domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future: Loom App integration (see src/lib/loom-integration.ts)
# LOOM_API_TOKEN=your_loom_api_token_here
